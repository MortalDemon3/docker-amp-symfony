{% extends 'base.html.twig' %}

{% block title %}Artist{% endblock %}

{% block body %}
    <div class="row">
        <div class="sm:col-6 md:col-3">
            <img src="{{artist.thumbnail}}" class="img-fluid rounded" alt="Illustration de l'artiste">

            <div class="d-flex flex-column gap-2">
                <a href="{{path('app_artist_release_new', {'id': artist.id}) }}" class="btn-subtle theme-primary">Nouvelle release</a>
                <a class="btn-subtle w-100" href="{{path('app_artist_edit', {'id': artist.id})}}">Modifier</a>
                <a class="btn-subtle w-100" href="{{path('app_artist_index')}}">Back to list</a>
                {{include('artist/_delete_form.html.twig')}}
            </div>
        </div>
        <div class="col-auto">
            <h1>{{ artist.name }}</h1>
        </div>
    </div>




{% endblock %}